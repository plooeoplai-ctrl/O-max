    Icon = "help-circle", -- optional
    Locked = false,
})

Tab2:Button({
    Title = "อมตะ",
    Icon = "shield",
    Callback = function()
        humanoid.Health = math.huge
        humanoid.MaxHealth = math.huge
        humanoid.BreakJointsOnDeath = false
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        humanoid.Died:Connect(function()
            humanoid.Health = math.huge
        end)
    end
})

Tab2:Button({
    Title = "เปิดกล่องเร็ว",
